<!DOCTYPE html>
<html lang="pt">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>mimou — Gift Boxes</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=DM+Serif+Display:ital@0;1&family=Instrument+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --cream: #ffffff; --cream-dark: #F0E9DF; --blue: #2B4BAA; --blue-light: #3D5EC4;
    --blue-pale: #EBF0FF; --gold: #C9A96E; --gold-dark: #B8924A; --blush: #F2DDD5;
    --text: #1A1A2E; --text-soft: #555; --text-mute: #888; --white: #FAF5EF;
    --error: #C25A5A; --success: #4A7C59; --border: #E5DED4;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { background: var(--cream); font-family: 'Instrument Sans', sans-serif; color: var(--text); line-height: 1.6; min-height: 100vh; }

  .topbar { background: var(--blue); color: var(--white); padding: 14px 32px; text-align: center; font-size: 12px; letter-spacing: 1.5px; }
  .topbar strong { color: var(--gold); letter-spacing: 2px; }

  .header { background: var(--cream); padding: 18px 40px 12px; text-align: center; border-bottom: 1px solid var(--border); }
  .logo-top { width: 100%; max-width: 380px; margin: 0 auto 10px; display: block; }
  .logo-top img { width: 100%; height: auto; display: block; }
  .brand-sub { font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 12px; color: var(--text-mute); letter-spacing: 1px; }

  /* NAV TABS */
  .nav-tabs { display: flex; justify-content: center; gap: 0; background: var(--white); border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 100; }
  .nav-tab { padding: 18px 40px; font-size: 12px; letter-spacing: 3px; text-transform: uppercase; font-weight: 600; color: var(--text-mute); cursor: pointer; border-bottom: 3px solid transparent; transition: all 0.3s ease; background: none; border-top: none; border-left: none; border-right: none; font-family: 'Instrument Sans', sans-serif; }
  .nav-tab:hover { color: var(--blue); }
  .nav-tab.active { color: var(--blue); border-bottom-color: var(--gold); }

  .page-section { display: none; animation: fadeIn 0.4s ease; }
  .page-section.active { display: block; }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

  .hero { padding: 60px 40px 40px; text-align: center; max-width: 700px; margin: 0 auto; }
  .hero .eyebrow { font-size: 11px; letter-spacing: 4px; text-transform: uppercase; color: var(--gold); margin-bottom: 16px; font-weight: 500; }
  .hero h1 { font-family: 'Cormorant Garamond', serif; font-size: clamp(32px, 5vw, 52px); font-weight: 300; color: var(--blue); line-height: 1.1; margin-bottom: 20px; }
  .hero h1 em { font-style: italic; color: var(--gold); }
  .hero p { font-size: 16px; color: var(--text-soft); max-width: 540px; margin: 0 auto; }

  .progress-wrap { max-width: 700px; margin: 40px auto 0; padding: 0 32px; }
  .progress-track { display: flex; justify-content: space-between; position: relative; margin-bottom: 12px; }
  .progress-track::before { content: ''; position: absolute; top: 14px; left: 14px; right: 14px; height: 1px; background: var(--border); z-index: 0; }
  .progress-bar { position: absolute; top: 14px; left: 14px; height: 1px; background: var(--gold); z-index: 1; width: 0%; transition: width 0.4s ease; }
  .step-dot { width: 28px; height: 28px; border-radius: 50%; background: var(--cream); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 600; color: var(--text-mute); position: relative; z-index: 2; transition: all 0.3s ease; }
  .step-dot.active { background: var(--blue); color: var(--white); border-color: var(--blue); }
  .step-dot.done { background: var(--gold); color: var(--white); border-color: var(--gold); }
  .progress-labels { display: flex; justify-content: space-between; font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--text-mute); margin-top: 8px; }
  .progress-labels span.active { color: var(--blue); font-weight: 600; }

  .form-wrap { max-width: 700px; margin: 40px auto 80px; padding: 0 32px; }
  .form-card { background: var(--white); padding: 48px 44px; border: 1px solid var(--border); box-shadow: 0 4px 24px rgba(43,75,170,0.04); }
  .step { display: none; animation: slideIn 0.4s ease; }
  .step.active { display: block; }
  @keyframes slideIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }

  .step-header { margin-bottom: 36px; padding-bottom: 24px; border-bottom: 1px dashed var(--border); }
  .step-num { font-family: 'Cormorant Garamond', serif; font-size: 12px; letter-spacing: 3px; text-transform: uppercase; color: var(--gold); margin-bottom: 8px; }
  .step-title { font-family: 'Cormorant Garamond', serif; font-size: 32px; font-weight: 400; color: var(--blue); line-height: 1.2; }
  .step-title em { font-style: italic; }
  .step-desc { font-size: 14px; color: var(--text-soft); margin-top: 8px; }

  .field { margin-bottom: 24px; }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  label { display: block; font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: var(--text); margin-bottom: 8px; font-weight: 600; }
  label .req { color: var(--gold); margin-left: 2px; }
  label .opt { color: var(--text-mute); font-weight: 400; text-transform: none; letter-spacing: 0; font-size: 11px; }

  input[type="text"], input[type="email"], input[type="tel"], input[type="date"], input[type="time"], input[type="number"], textarea, select {
    width: 100%; padding: 14px 16px; background: var(--cream); border: 1px solid var(--border); border-radius: 0;
    font-family: 'Instrument Sans', sans-serif; font-size: 15px; color: var(--text); transition: all 0.2s ease;
  }
  input:focus, textarea:focus, select:focus { outline: none; border-color: var(--blue); background: var(--white); }
  textarea { min-height: 120px; resize: vertical; line-height: 1.6; }
  input::placeholder, textarea::placeholder { color: var(--text-mute); font-style: italic; }
  .field-hint { font-size: 12px; color: var(--text-mute); margin-top: 6px; font-style: italic; }

  .radio-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .radio-card { position: relative; cursor: pointer; }
  .radio-card input { position: absolute; opacity: 0; }
  .radio-card .card-content { padding: 20px; background: var(--cream); border: 1px solid var(--border); text-align: center; transition: all 0.2s ease; }
  .radio-card input:checked + .card-content { background: var(--blue-pale); border-color: var(--blue); box-shadow: 0 0 0 2px var(--blue); }
  .radio-card .card-icon { font-size: 28px; margin-bottom: 8px; }
  .radio-card .card-title { font-family: 'Cormorant Garamond', serif; font-size: 18px; color: var(--blue); font-weight: 500; }
  .radio-card .card-sub { font-size: 11px; color: var(--text-mute); margin-top: 4px; letter-spacing: 0.5px; }

  .kit-grid { display: grid; grid-template-columns: 1fr; gap: 14px; }
  .kit-card { position: relative; cursor: pointer; }
  .kit-card input { position: absolute; opacity: 0; }
  .kit-content { padding: 24px; background: var(--cream); border: 1px solid var(--border); transition: all 0.2s ease; display: grid; grid-template-columns: 1fr auto; gap: 20px; align-items: flex-start; }
  .kit-card input:checked + .kit-content { background: var(--white); border-color: var(--blue); box-shadow: 0 0 0 2px var(--blue), 0 8px 24px rgba(43,75,170,0.08); }
  .kit-card.featured .kit-content::before { content: '★ MAIS POPULAR'; position: absolute; top: -10px; left: 24px; background: var(--gold); color: var(--white); font-size: 9px; letter-spacing: 2px; padding: 4px 10px; font-weight: 600; }
  .kit-info h4 { font-family: 'Cormorant Garamond', serif; font-size: 22px; color: var(--blue); font-weight: 500; margin-bottom: 4px; }
  .kit-info .kit-sub { font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--gold); margin-bottom: 10px; font-weight: 500; }
  .kit-info ul { list-style: none; font-size: 13px; color: var(--text-soft); line-height: 1.7; }
  .kit-info ul li::before { content: '— '; color: var(--gold); }
  .kit-price { text-align: right; }
  .kit-price .num { font-family: 'Cormorant Garamond', serif; font-size: 38px; color: var(--blue); font-weight: 300; line-height: 1; }
  .kit-price .num span { font-size: 18px; vertical-align: top; }
  .kit-price .label { font-size: 9px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--text-mute); margin-top: 4px; }

  .address-block { background: var(--cream); padding: 20px; border-left: 3px solid var(--gold); margin-top: 12px; }
  .checkbox { display: flex; align-items: flex-start; gap: 12px; cursor: pointer; padding: 16px; background: var(--cream); border: 1px solid var(--border); transition: all 0.2s ease; }
  .checkbox:hover { background: var(--blue-pale); }
  .checkbox input { margin-top: 2px; cursor: pointer; }
  .checkbox-text { font-size: 13px; color: var(--text); line-height: 1.6; }

  .alert { padding: 16px 20px; background: var(--blue-pale); border-left: 3px solid var(--blue); margin-bottom: 24px; font-size: 13px; color: var(--blue); line-height: 1.5; }
  .alert strong { display: block; margin-bottom: 4px; letter-spacing: 0.5px; }

  .summary { background: var(--cream); padding: 28px; border-left: 3px solid var(--gold); margin-bottom: 28px; }
  .summary h3 { font-family: 'Cormorant Garamond', serif; font-size: 22px; color: var(--blue); margin-bottom: 18px; font-weight: 500; }
  .summary h3 em { font-style: italic; }
  .summary-row { display: grid; grid-template-columns: 130px 1fr; gap: 16px; padding: 10px 0; border-bottom: 1px dashed var(--border); font-size: 14px; }
  .summary-row:last-child { border-bottom: none; }
  .summary-row .label-s { font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--text-mute); font-weight: 600; }
  .summary-row .val { color: var(--text); }
  .summary-row .val.price { font-family: 'Cormorant Garamond', serif; font-size: 24px; color: var(--blue); font-weight: 500; }

  .actions { display: flex; justify-content: space-between; margin-top: 36px; gap: 16px; }
  .btn { padding: 16px 32px; border: none; cursor: pointer; font-family: 'Instrument Sans', sans-serif; font-size: 11px; letter-spacing: 3px; text-transform: uppercase; font-weight: 600; transition: all 0.2s ease; display: inline-flex; align-items: center; gap: 10px; }
  .btn-primary { background: var(--blue); color: var(--white); }
  .btn-primary:hover { background: var(--blue-light); transform: translateX(2px); }
  .btn-primary:disabled { background: var(--text-mute); cursor: not-allowed; transform: none; }
  .btn-secondary { background: transparent; color: var(--text-soft); border: 1px solid var(--border); }
  .btn-secondary:hover { border-color: var(--blue); color: var(--blue); }
  .btn-gold { background: var(--gold); color: var(--white); }
  .btn-gold:hover { background: var(--gold-dark); }

  .success-screen { display: none; text-align: center; padding: 40px 20px; }
  .success-screen.active { display: block; animation: slideIn 0.6s ease; }
  .success-icon { width: 80px; height: 80px; margin: 0 auto 24px; border-radius: 50%; background: var(--blue-pale); display: flex; align-items: center; justify-content: center; font-size: 36px; }
  .success-screen h2 { font-family: 'Cormorant Garamond', serif; font-size: 36px; color: var(--blue); font-weight: 400; line-height: 1.2; margin-bottom: 12px; }
  .success-screen h2 em { font-style: italic; color: var(--gold); }
  .success-screen .lead { font-size: 15px; color: var(--text-soft); max-width: 480px; margin: 0 auto 32px; }

  .payment-card { background: var(--blue); color: var(--white); padding: 40px 32px; text-align: left; margin: 32px 0; }
  .payment-card .label-pay { font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: var(--gold); margin-bottom: 8px; }
  .payment-card h3 { font-family: 'Cormorant Garamond', serif; font-size: 28px; font-weight: 400; margin-bottom: 24px; }
  .payment-card h3 em { font-style: italic; }
  .pay-info { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; padding: 20px 0; border-top: 1px solid rgba(255,255,255,0.15); border-bottom: 1px solid rgba(255,255,255,0.15); margin: 20px 0; }
  .pay-info-item .pl { font-size: 10px; letter-spacing: 2px; text-transform: uppercase; opacity: 0.6; margin-bottom: 4px; }
  .pay-info-item .pv { font-family: 'Cormorant Garamond', serif; font-size: 22px; color: var(--gold); }
  .pay-steps { list-style: none; counter-reset: step-counter; }
  .pay-steps li { counter-increment: step-counter; padding: 8px 0 8px 36px; position: relative; font-size: 14px; line-height: 1.6; opacity: 0.9; }
  .pay-steps li::before { content: counter(step-counter); position: absolute; left: 0; top: 8px; width: 24px; height: 24px; background: var(--gold); color: var(--white); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 600; }

  .next-steps { background: var(--cream); padding: 28px; margin-top: 24px; text-align: left; }
  .next-steps h4 { font-family: 'Cormorant Garamond', serif; font-size: 18px; color: var(--blue); margin-bottom: 12px; font-weight: 500; }
  .next-steps ul { list-style: none; font-size: 13px; color: var(--text-soft); }
  .next-steps ul li { padding: 6px 0 6px 20px; position: relative; }
  .next-steps ul li::before { content: '✓'; position: absolute; left: 0; color: var(--gold); font-weight: 600; }

  .site-footer { background: var(--cream-dark); padding: 32px 40px; text-align: center; }
  .site-footer p { font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 14px; color: var(--text-mute); }
  .site-footer a { color: var(--blue); text-decoration: none; }

  /* ABOUT PAGE STYLES */
  .about-content { max-width: 900px; margin: 0 auto; padding: 40px 32px 80px; display: grid; grid-template-columns: 1fr; gap: 32px; }
  
  .about-block { 
    background: var(--white); 
    padding: 40px; 
    border: 1px solid var(--border); 
    box-shadow: 0 4px 24px rgba(43,75,170,0.04);
    border-left: 4px solid var(--gold);
    transition: all 0.3s ease;
  }
  
  .about-block:hover { box-shadow: 0 8px 40px rgba(43,75,170,0.08); transform: translateY(-2px); }
  
  .about-icon { 
    font-size: 42px; 
    margin-bottom: 16px; 
    opacity: 0.9;
  }
  
  .about-title { 
    font-family: 'Cormorant Garamond', serif; 
    font-size: 28px; 
    color: var(--blue); 
    margin-bottom: 16px; 
    font-weight: 500;
    line-height: 1.2;
  }
  
  .about-title em { 
    font-style: italic; 
    color: var(--gold);
  }
  
  .about-text { 
    font-size: 15px; 
    color: var(--text-soft); 
    line-height: 1.8; 
    margin-bottom: 16px;
  }
  
  .about-text:last-child { margin-bottom: 0; }
  
  .about-text strong { 
    color: var(--blue); 
    font-weight: 600;
  }

  .has-error input, .has-error textarea, .has-error select { border-color: var(--error); background: #fff5f5; }
  .error-msg { display: none; color: var(--error); font-size: 12px; margin-top: 4px; font-weight: 500; }
  .has-error .error-msg { display: block; }

  .loading { display: none; align-items: center; gap: 8px; }
  .loading.active { display: inline-flex; }
  .spinner { width: 14px; height: 14px; border: 2px solid rgba(255,255,255,0.3); border-top-color: var(--white); border-radius: 50%; animation: spin 0.8s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }

  .config-warning { background: #FDF6E7; border: 2px solid #D4A356; padding: 16px 20px; margin: 20px auto; max-width: 700px; font-size: 13px; color: #8B6E2A; }
  .config-warning strong { display: block; margin-bottom: 4px; }

  /* ========== NOSSAS CAIXAS STYLES ========== */
  .boxes-hero { padding: 60px 40px 40px; text-align: center; max-width: 800px; margin: 0 auto; }
  .boxes-hero .eyebrow { font-size: 11px; letter-spacing: 4px; text-transform: uppercase; color: var(--gold); margin-bottom: 16px; font-weight: 500; }
  .boxes-hero h1 { font-family: 'Cormorant Garamond', serif; font-size: clamp(32px, 5vw, 52px); font-weight: 300; color: var(--blue); line-height: 1.1; margin-bottom: 20px; }
  .boxes-hero h1 em { font-style: italic; color: var(--gold); }
  .boxes-hero p { font-size: 16px; color: var(--text-soft); max-width: 580px; margin: 0 auto; }

  .boxes-grid { max-width: 900px; margin: 0 auto 80px; padding: 0 32px; display: grid; grid-template-columns: 1fr; gap: 32px; }

  .box-card { background: var(--white); border: 1px solid var(--border); overflow: hidden; box-shadow: 0 4px 24px rgba(43,75,170,0.04); transition: transform 0.3s ease, box-shadow 0.3s ease; }
  .box-card:hover { transform: translateY(-4px); box-shadow: 0 12px 40px rgba(43,75,170,0.08); }
  .box-card.featured-box { border: 2px solid var(--gold); position: relative; }
  .box-card.featured-box::before { content: '★ MAIS POPULAR'; position: absolute; top: 0; left: 0; right: 0; background: var(--gold); color: var(--white); font-size: 10px; letter-spacing: 3px; padding: 8px; text-align: center; font-weight: 600; z-index: 1; }
  .box-card.featured-box .box-card-inner { padding-top: 52px; }

  .box-card-inner { padding: 40px; display: grid; grid-template-columns: 1fr auto; gap: 40px; align-items: center; }

  .box-name { font-family: 'Cormorant Garamond', serif; font-size: 28px; color: var(--blue); font-weight: 500; margin-bottom: 4px; }
  .box-subtitle { font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: var(--gold); font-weight: 600; margin-bottom: 20px; }

  .box-items { list-style: none; font-size: 14px; color: var(--text-soft); line-height: 2; }
  .box-items li { display: flex; align-items: center; gap: 10px; }
  .box-items li::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--gold); flex-shrink: 0; }
  .box-items li.highlight { color: var(--text); font-weight: 600; }
  .box-items li.highlight::before { background: var(--blue); width: 8px; height: 8px; }

  .box-price-block { display: flex; flex-direction: row; align-items: stretch; gap: 0; background: var(--cream); padding: 0; min-width: 460px; }
  .box-price-block .box-img { width: 290px; min-width: 290px; height: 310px; object-fit: cover; display: block; flex-shrink: 0; }
  .box-price-block .box-price-info { padding: 32px 32px 32px; display: flex; flex-direction: column; align-items: center; justify-content: center; flex: 1; }
  .box-price-block .price-val { font-family: 'Cormorant Garamond', serif; font-size: 52px; color: var(--blue); font-weight: 300; line-height: 1; text-align: center; }
  .box-price-block .price-val span { font-size: 24px; vertical-align: top; }
  .box-price-block .price-label { font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: var(--text-mute); margin-top: 8px; text-align: center; }
  .box-price-block .btn-order { margin-top: 20px; padding: 12px 24px; background: var(--blue); color: var(--white); border: none; cursor: pointer; font-family: 'Instrument Sans', sans-serif; font-size: 10px; letter-spacing: 2px; text-transform: uppercase; font-weight: 600; transition: all 0.2s ease; width: 100%; }
  .box-price-block .btn-order:hover { background: var(--blue-light); }

  .delivery-info { max-width: 900px; margin: 0 auto 60px; padding: 0 32px; }
  .delivery-info-card { background: var(--white); border: 1px solid var(--border); padding: 40px; display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
  .delivery-info-card h3 { font-family: 'Cormorant Garamond', serif; font-size: 22px; color: var(--blue); font-weight: 500; margin-bottom: 16px; grid-column: 1 / -1; }
  .info-block h4 { font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: var(--gold); margin-bottom: 8px; font-weight: 600; }
  .info-block p { font-size: 14px; color: var(--text-soft); line-height: 1.7; }
  .info-block .price-tag { font-family: 'Cormorant Garamond', serif; font-size: 20px; color: var(--blue); margin-top: 4px; }

  @media (max-width: 600px) {
    .header { padding: 24px; }
    .brand img { height: 70px; }
    .hero, .boxes-hero { padding: 40px 24px 32px; }
    .progress-wrap { padding: 0 24px; } .progress-labels { display: none; }
    .form-wrap { margin: 24px auto 60px; padding: 0 16px; } .form-card { padding: 32px 24px; }
    .field-row { grid-template-columns: 1fr; gap: 0; } .radio-cards { grid-template-columns: 1fr; }
    .kit-content { grid-template-columns: 1fr; gap: 16px; } .kit-price { text-align: left; }
    .actions { flex-direction: column-reverse; } .actions .btn { width: 100%; justify-content: center; }
    .pay-info { grid-template-columns: 1fr; gap: 16px; }
    .summary-row { grid-template-columns: 1fr; gap: 4px; }
    .step-title { font-size: 26px; }
    .nav-tab { padding: 14px 20px; font-size: 10px; letter-spacing: 2px; }
    .box-card-inner { grid-template-columns: 1fr; gap: 20px; }
    .box-price-block { flex-direction: column; min-width: unset; }
    .box-price-block .box-img { width: 100%; min-width: unset; height: 220px; }
    .box-price-block .box-price-info { padding: 20px; align-items: center; }
    .delivery-info-card { grid-template-columns: 1fr; gap: 20px; padding: 28px; }
    .boxes-grid { padding: 0 16px; }
  }
</style>
</head>
<body>

<div class="topbar">
  <strong>✦ PROMOÇÃO: Entregas GRÁTIS para o município do Porto ✦ Encomendas com antecedência mínima de 24 horas</strong>
</div>

<header class="header">
  <div class="logo-top"><img src="data:image/png;base64," alt="mimou" style="max-width: 400px; height: auto;" /></div>
  <div class="brand-sub">gift boxes — feitas à mão, no Porto</div>
</header>

<!-- NAVIGATION TABS -->
<nav class="nav-tabs">
