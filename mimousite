  <p>mimou · feito à mão no Porto · <a href="mailto:mimoupt@gmail.com">mimoupt@gmail.com</a> · <a href="https://wa.me/351926535140">+351 926535140</a></p>
</footer>

<script>
// ============================================================
// PAGE SWITCHING
// ============================================================
function switchPage(page) {
  document.querySelectorAll('.page-section').forEach(s => s.classList.remove('active'));
  document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
  document.getElementById('page-' + page).classList.add('active');
  document.querySelector(`.nav-tab[data-page="${page}"]`).classList.add('active');
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function goToOrder(kitValue) {
  switchPage('pedido');
  // Pre-select the kit when navigating from boxes page
  setTimeout(() => {
    const kitRadio = document.querySelector(`input[name="kit"][value="${kitValue}"]`);
    if (kitRadio) kitRadio.checked = true;
  }, 100);
}

// ============================================================
// ⚠️ CONFIGURAÇÃO — substitui pelo URL do teu Apps Script
// ============================================================
const APPS_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbySMT5C6MV4pPJ_H5fYwSfl3Qm83xh5NPecgCj7keD0djG8Y776hmMwHIJ9zFGRAZtg/exec';

if (APPS_SCRIPT_URL === 'APPS_SCRIPT_URL_AQUI') {
  document.getElementById('configWarning').style.display = 'block';
}

// ============================================================
// VALIDAÇÃO DE DATA E CÓDIGO POSTAL
// ============================================================
function validateDeliveryDate() {
  const dateInput = document.getElementById('data');
  dateInput.setCustomValidity('');
  if (!dateInput.value) return;
  const selectedDate = new Date(dateInput.value);
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  const minDate = new Date(today);
  minDate.setDate(minDate.getDate() + 1);
  const month = selectedDate.getMonth();
  const day = selectedDate.getDate();
  const isBlockedPeriod = month === 6 && day >= 7 && day <= 30;
  if (selectedDate < minDate) {
    document.getElementById('dateHint').textContent = '❌ Mínimo 24h de antecedência';
  } else if (isBlockedPeriod) {
    document.getElementById('dateHint').textContent = '❌ Não disponível nesta data (7-30 de julho)';
  } else {
    document.getElementById('dateHint').textContent = '✅ Data disponível';
  }
}

function validatePostalCode() {
  const cp = document.getElementById('cp');
  cp.setCustomValidity('');
}

// ============================================================
// 4 PASSOS DO FORMULÁRIO
// ============================================================
const KITS = {
  essential: { name: 'Box Mimo', price: 30 },
  special:   { name: 'Box Especial', price: 39 },
  luxury:    { name: 'Box Luxo', price: 48 }
};

let currentStep = 1;
const totalSteps = 4;

function goToStep(step) {
  document.querySelectorAll('.step').forEach(s => s.classList.remove('active'));
  document.querySelector(`.step[data-step="${step}"]`).classList.add('active');
  document.querySelectorAll('.step-dot').forEach((dot, i) => {
    dot.classList.remove('active', 'done');
    if (i + 1 < step) dot.classList.add('done');
    else if (i + 1 === step) dot.classList.add('active');
  });
  document.querySelectorAll('.progress-labels span').forEach((sp, i) => {
    sp.classList.toggle('active', i + 1 === step);
  });
  document.getElementById('progressBar').style.width = (((step - 1) / (totalSteps - 1)) * 100) + '%';
  document.querySelector('.form-wrap').scrollIntoView({ behavior: 'smooth', block: 'start' });
  currentStep = step;
}

function nextStep(from) {
  if (!validateStep(from)) return;
  if (from === 3) buildSummary();
  goToStep(from + 1);
}

function prevStep(from) { goToStep(from - 1); }

function validateStep(step) {
  let valid = true;
  if (step === 1) {
    valid = checkField('nome') && checkField('telemovel') && checkEmail('email');
  }
  if (step === 2) {
    const tipo = document.querySelector('input[name="tipo_entrega"]:checked').value;
    if (tipo === 'delivery') {
      valid = checkField('morada') && checkField('cp');
    }
    if (!document.getElementById('janela').value) {
      document.getElementById('janela').closest('.field').classList.add('has-error');
      valid = false;
    }
  }
  if (step === 3) {
    const kit = document.querySelector('input[name="kit"]:checked');
    const kitField = document.querySelector('.kit-grid').closest('.field');
    if (!kit) { kitField.classList.add('has-error'); valid = false; }
    else { kitField.classList.remove('has-error'); }
    if (!checkField('mensagem')) valid = false;
  }
  return valid;
}

function checkField(id) {
  const el = document.getElementById(id);
  const fg = el.closest('.field');
  if (!el.value.trim()) { fg.classList.add('has-error'); return false; }
  fg.classList.remove('has-error');
  return true;
}

function checkEmail(id) {
  const el = document.getElementById(id);
  const fg = el.closest('.field');
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(el.value)) { fg.classList.add('has-error'); return false; }
  fg.classList.remove('has-error');
  return true;
}

function toggleAddress() {
  const tipo = document.querySelector('input[name="tipo_entrega"]:checked').value;
  const block = document.getElementById('addressBlock');
  const alert = document.getElementById('alertPorto');
  const pickupNotice = document.getElementById('pickupNotice');
  if (tipo === 'pickup') { 
    block.style.display = 'none';
    alert.style.display = 'none';
    pickupNotice.style.display = 'block';
    block.querySelectorAll('input, textarea, select').forEach(field => { field.disabled = true; });
  } else { 
    block.style.display = 'block';
    alert.style.display = 'block';
    pickupNotice.style.display = 'none';
    block.querySelectorAll('input, textarea, select').forEach(field => { field.disabled = false; });
  }
}

function buildSummary() {
  const tipo = document.querySelector('input[name="tipo_entrega"]:checked').value;
  const isDelivery = tipo === 'delivery';
  const morada = isDelivery
    ? `${document.getElementById('morada').value || ''}${document.getElementById('cp').value ? ', ' + document.getElementById('cp').value : ''}${document.getElementById('freguesia').value ? ', ' + document.getElementById('freguesia').value : ''}`
    : 'Levantamento no nosso ponto';
  const dataEntrega = document.getElementById('data').value 
    ? new Date(document.getElementById('data').value).toLocaleDateString('pt-PT', { weekday: 'long', day: 'numeric', month: 'long' }) 
    : '—';
  const kitId = document.querySelector('input[name="kit"]:checked')?.value;
  const kit = kitId ? KITS[kitId] : null;
  const mensagem = document.getElementById('mensagem').value;
  const mSnippet = mensagem.substring(0, 100) + (mensagem.length > 100 ? '...' : '');
  const deliveryFee = 0; // Entrega GRÁTIS
  const totalPrice = kit ? (kit.price + deliveryFee) : deliveryFee;

  document.getElementById('summaryContent').innerHTML = `
    <div class="summary-row"><span class="label-s">Nome</span><span class="val">${document.getElementById('nome').value}</span></div>
    <div class="summary-row"><span class="label-s">Contactos</span><span class="val">${document.getElementById('telemovel').value} · ${document.getElementById('email').value}</span></div>
    <div class="summary-row"><span class="label-s">Entrega</span><span class="val">${isDelivery ? 'Entrega no Porto' : 'Levantamento'}<br><small style="color:var(--text-mute);">${morada}</small></span></div>
    <div class="summary-row"><span class="label-s">Quando</span><span class="val">${dataEntrega} · ${document.getElementById('janela').value}</span></div>
    <div class="summary-row"><span class="label-s">Para</span><span class="val">${document.getElementById('nomeMae').value || '—'}</span></div>
    <div class="summary-row"><span class="label-s">Mensagem</span><span class="val" style="font-style:italic;color:var(--text-soft);">"${mSnippet || '—'}"</span></div>
    <div class="summary-row" style="border-top: 1px solid var(--blue); padding-top: 16px; margin-top: 8px;">
      <span class="label-s">Kit</span>
      <span class="val price">${kit ? kit.name + ' — €' + kit.price : '—'}</span>
    </div>
    <div class="summary-row" style="border-top: 1px solid var(--blue); padding-top: 16px; margin-top: 8px;">
      <span class="label-s">Total</span>
      <span class="val price">€${totalPrice}</span>
    </div>
  `;
}

// ============================================================
// SUBMISSION → APPS SCRIPT
// ============================================================
document.getElementById('orderForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  if (!document.getElementById('termos').checked) {
    alert('Por favor aceita os termos para continuar.'); return;
  }
  if (APPS_SCRIPT_URL === 'APPS_SCRIPT_URL_AQUI') {
    alert('⚠️ O site ainda não foi configurado. Contacta-nos por WhatsApp.'); return;
  }

  const submitBtn = document.getElementById('submitBtn');
  const btnText = submitBtn.querySelector('.btn-text');
  const loading = submitBtn.querySelector('.loading');
  submitBtn.disabled = true;
  btnText.style.display = 'none';
  loading.classList.add('active');

  const tipo = document.querySelector('input[name="tipo_entrega"]:checked').value;
  const kitId = document.querySelector('input[name="kit"]:checked').value;
  const kit = KITS[kitId];
  const isDelivery = tipo === 'delivery';
  const deliveryFee = 0; // Entrega GRÁTIS

  const order = {
    name: document.getElementById('nome').value.trim(),
    phone: document.getElementById('telemovel').value.trim(),
    email: document.getElementById('email').value.trim(),
    como_conheceu: document.getElementById('origem').value,
    delivery_type: tipo,
    address: tipo === 'delivery' ? document.getElementById('morada').value.trim() : '',
    postal_code: tipo === 'delivery' ? document.getElementById('cp').value.trim() : '',
    freguesia: document.getElementById('freguesia').value.trim(),
    references: document.getElementById('referencias').value.trim(),
    delivery_date: document.getElementById('data').value,
    delivery_window: document.getElementById('janela').value,
    kit_id: kitId,
    kit_name: kit.name,
    kit_price: kit.price,
    delivery_fee: deliveryFee,
    total_price: kit.price + deliveryFee,
    recipient: document.getElementById('nomeMae').value.trim(),
    message: document.getElementById('mensagem').value.trim(),
    special_requests: document.getElementById('pedidos').value.trim()
  };

  try {
    const response = await fetch(APPS_SCRIPT_URL, {
      method: 'POST',
      body: JSON.stringify({ action: 'new_order', order: order })
    });
    const result = await response.json();
    if (result.ok) {
      const totalAmount = kit.price + deliveryFee;
      document.getElementById('totalPagar').textContent = '€' + totalAmount;
      document.querySelectorAll('.step').forEach(s => s.classList.remove('active'));
      document.getElementById('successScreen').classList.add('active');
      document.getElementById('progressWrap').style.display = 'none';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } else {
      throw new Error(result.error || 'Erro desconhecido');
    }
  } catch (err) {
    alert('Algo correu mal. Tenta novamente ou contacta-nos por WhatsApp.\n\nErro: ' + err.message);
    submitBtn.disabled = false;
    btnText.style.display = 'inline';
    loading.classList.remove('active');
  }
});

toggleAddress();

document.getElementById('cp').addEventListener('change', validatePostalCode);
document.getElementById('data').addEventListener('change', validateDeliveryDate);
document.querySelectorAll('input[name="tipo_entrega"]').forEach(radio => {
  radio.addEventListener('change', toggleAddress);
});
</script>
</body>
</html>
